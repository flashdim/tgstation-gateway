WINE_PROTON_VERSION="${WINE_PROTON_VERSION:-10.0-4}"
case "$WINE_PROTON_VERSION" in
    10.0-4) WINE_PROTON_SHA256=ffaf6e766f916a408d273254f6b9c42b1589ac1bb4b02e09ab04650c87bca290 ;;
    11.0-2) WINE_PROTON_SHA256=51e1b54068c242c0a59c329674afe4b0ae03d313516a535be4acd1c5f3277e9b ;;
    *)
        echo "Unsupported WINE_PROTON_VERSION: $WINE_PROTON_VERSION" >&2
        exit 1
        ;;
esac
