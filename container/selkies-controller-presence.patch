+    def set_controllers_present(self, present: bool) -> None:
+        """Run controller-only hooks for active data-stream connections."""
+        if present == self._controllers_present:
+            return
+        self._controllers_present = present
+        name = "CONNECT" if present else "DISCONNECT"
+        cmd = os.environ.get(f"SELKIES_RUN_AFTER_CONTROLLER_{name}", "")
+        if cmd:
+            task = asyncio.create_task(self._run_client_hook(cmd, present))
+            self._client_hook_tasks.add(task)
+            task.add_done_callback(self._client_hook_tasks.discard)
